# ─── Transcription ──────────────────────────────────────────────────────────
# Whisper model: base (fast, less accurate) → small → medium → large-v3-turbo (slow, accurate)
# Or a full HF model id like openai/whisper-large-v3-turbo
WHISPER_MODEL=base
# Force a language (e.g. en); leave empty for auto-detect
WHISPER_LANGUAGE=

# ─── Editing ────────────────────────────────────────────────────────────────
# silence: mute the word | bleep: 1 kHz tone | remove: cut the audio (audio files only)
CENSOR_METHOD=silence
# Seconds per analysis chunk (lower = less RAM, more overhead)
ANALYSIS_CHUNK_SIZE=60

# ─── Smart Cut (optional LLM refinement of cuts) ───────────────────────────
# Enable the LLM to widen cuts into idioms ("go to hell") or reject false positives ("hoe" the tool).
AI_ENHANCE=False
# google: Gemini API | local: any OpenAI-compatible server (llama.cpp, vLLM, etc.)
AI_MODE=google
GOOGLE_API_KEY=
LOCAL_LLM_URL=http://localhost:8080/v1/chat/completions
LOCAL_LLM_MODEL=

# ─── VRAM sharing ──────────────────────────────────────────────────────────
# Free GPU memory after every job so other GPU apps can reclaim it.
# Next job pays a model reload (~30-60s cold, instant via Resume).
UNLOAD_MODELS_AFTER_JOB=True
# Split audio across all GPUs (data-parallel): each GPU loads its own full
# model and transcribes a different chunk concurrently, ~halving wall time.
# Off by default (single GPU). Requires >1 visible GPU.
WHISPER_MULTI_GPU=False
# Attention override (e.g. eager) if Triton SDPA kernels misbehave. 
# WHISPER_ATTN Empty default is valid. Only set it to eager if Triton SDPA kernels misbehave on your specific GPU.
WHISPER_ATTN=
# While an LLM holds VRAM, set to cpu to avoid OOM during alignment:
# ALIGN_DEVICE=cpu

# ─── Bad Words List ─────────────────────────────────────────────────────────
# Path to the plain-text file of words to censor (one per line).
# The Docker image ships a starter list at /data/bad_words.txt.
# Edit it inside the container: docker compose exec foulfilter nano /data/bad_words.txt
BAD_WORDS_PATH=/data/bad_words.txt

# ─── Build ──────────────────────────────────────────────────────────────────
# PyTorch wheel index baked into the image. Change the vendor/tag and rebuild:
#   AMD ROCm:  https://download.pytorch.org/whl/rocm7.2
#   NVIDIA:    https://download.pytorch.org/whl/cu128
#   CPU only:  https://download.pytorch.org/whl/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
